{
  "name": "@abth/gui",
  "productName": "A Better Taiko Hiroba",
  "version": "0.0.0",
  "private": true,
  "description": "The desktop and Android app of A Better Taiko Hiroba",
  "author": "HicirTech",
  "license": "MIT",
  "type": "module",
  "main": "out/electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev-desktop.ts",
    "build:web": "bun --bun vite build",
    "build:electron": "bun scripts/build-electron.ts",
    "build": "bun run build:web && bun run build:electron",
    "start": "electron .",
    "e2e:desktop": "bun run build && bun scripts/e2e-desktop.ts"
  },
  "devDependencies": {
    "@abth/core": "workspace:*",
    "@abth/i18n": "workspace:*",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/material": "9.4.0",
    "@types/node": "^24.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  }
}
