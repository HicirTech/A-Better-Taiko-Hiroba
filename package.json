{
  "name": "a-better-taiko-hiroba",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "i18n",
    "gui"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun gui/scripts/dev-desktop.ts",
    "build:web": "bun --bun vite build gui",
    "build:electron": "bun gui/scripts/build-electron.ts",
    "build": "bun run build:web && bun run build:electron",
    "start": "electron gui",
    "e2e": "bun gui/scripts/e2e/run.ts",
    "storybook": "bun gui/scripts/storybook.ts",
    "build:storybook": "storybook build --config-dir gui/.storybook --output-dir gui/out/storybook --disable-telemetry",
    "dist:dir": "bun run build && electron-builder --projectDir gui --win --dir",
    "dist:win": "bun run build && electron-builder --projectDir gui --win nsis zip --x64",
    "dist:mac": "bun run build && electron-builder --projectDir gui --mac dmg --arm64 --x64",
    "smoke:packaged": "bun gui/scripts/smoke-packaged.ts",
    "android:apk": "bun gui/scripts/android.ts apk",
    "android:run": "bun gui/scripts/android.ts run",
    "android:live": "bun gui/scripts/android.ts live",
    "android:release": "bun gui/scripts/android.ts release",
    "check": "bun run --parallel --no-exit-on-error format:check lint typecheck test check:update-feed",
    "test": "bun test",
    "typecheck": "bun run --parallel --no-exit-on-error typecheck:core typecheck:i18n typecheck:gui typecheck:gui-electron typecheck:gui-node",
    "typecheck:core": "tsc --noEmit -p core",
    "typecheck:i18n": "tsc --noEmit -p i18n",
    "typecheck:gui": "tsc --noEmit -p gui",
    "typecheck:gui-electron": "tsc --noEmit -p gui/electron",
    "typecheck:gui-node": "tsc --noEmit -p gui/tsconfig.node.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --formatter-enabled=false .",
    "check:corpus": "bun run core/scripts/check-corpus.ts",
    "check:update-feed": "bun run gui/scripts/check-update-feed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.2.19",
    "typescript": "^5.6.0"
  }
}
