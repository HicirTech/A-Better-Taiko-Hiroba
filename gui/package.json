{
  "name": "@abth/gui",
  "productName": "A Better Taiko Hiroba",
  "version": "0.3.2",
  "private": true,
  "description": "The desktop and Android app of A Better Taiko Hiroba",
  "author": "HicirTech",
  "license": "MIT",
  "type": "module",
  "main": "out/electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev-desktop.ts",
    "build:web": "bun --bun vite build",
    "build:electron": "bun scripts/build-electron.ts",
    "build": "bun run build:web && bun run build:electron",
    "start": "electron .",
    "e2e:desktop": "bun scripts/e2e/run.ts",
    "dist:dir": "bun run build && electron-builder --win --dir",
    "dist:win": "bun run build && electron-builder --win nsis zip --x64",
    "smoke:packaged": "bun scripts/smoke-packaged.ts",
    "android:apk": "bun scripts/android.ts apk",
    "android:run": "bun scripts/android.ts run",
    "android:live": "bun scripts/android.ts live",
    "android:release": "bun scripts/android.ts release"
  },
  "build": {
    "appId": "com.hicirtech.taikohiroba",
    "productName": "A Better Taiko Hiroba",
    "files": [
      "out/web/**",
      "out/electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "ABTH-${version}-portable.${ext}",
      "icon": "icons/app-icon.png",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "ABTH-${version}-setup.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "devDependencies": {
    "@abth/core": "workspace:*",
    "@abth/i18n": "workspace:*",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/inappbrowser": "4.0.3",
    "@capacitor/toast": "8.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/material": "9.4.0",
    "@types/node": "^24.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "fast-png": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  }
}
