{
  "name": "@abth/gui",
  "productName": "A Better Taiko Hiroba",
  "version": "0.6.0",
  "private": true,
  "description": "The desktop and Android app of A Better Taiko Hiroba",
  "author": "HicirTech",
  "license": "MIT",
  "type": "module",
  "main": "out/electron/main.cjs",
  "build": {
    "appId": "com.hicirtech.taikohiroba",
    "productName": "A Better Taiko Hiroba",
    "files": [
      "out/web/**",
      "out/electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "ABTH-${version}-portable.${ext}",
      "icon": "icons/app-icon.png",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "ABTH-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "ABTH-${version}-mac-${arch}.${ext}",
      "icon": "icons/app-icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "devDependencies": {
    "@abth/core": "workspace:*",
    "@abth/i18n": "workspace:*",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/inappbrowser": "4.0.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/toast": "8.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@mui/material": "9.4.0",
    "@storybook/react-vite": "10.6.2",
    "@tanstack/react-virtual": "3.14.21",
    "@types/node": "^24.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "fast-png": "8.0.0",
    "html-to-image": "1.11.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.4",
    "storybook": "10.6.2",
    "vite": "8.3.1"
  }
}
